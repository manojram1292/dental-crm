+# ─── --directed: one pass per line, pauses found in the audio, pace by meaning ───────────────────────────────────────
+D_PAUSE = {',': 150, ';': 240, ':': 240, '.': 420, '?': 420, '!': 420, '…': 420, '—': 280}   # ms, inside a line
+PACE = (('role', 'hook', 1.10), ('rest', True, 0.94), ('music', 'joy', 1.03))   # (field, value, × speed); mixDb ≤ −4: 0.96, ≥ 1: 1.06
+FIT_MAX = 1.08   # the most a group's tempo may change in --fit
+FIT_GAP = 0.06   # s kept between two groups
+
+
+def pace(line):
+    m = 1.0
+    for key, val, k in PACE:
+        if line.get(key) == val:
+            m *= k
+    m *= 0.96 if line.get('mixDb', 0) <= -4 else 1.06 if line.get('mixDb', 0) >= 1 else 1.0
+    return m
+
+
+def style_of(spec):
+    """'am_michael' → its name (Kokoro looks it up); 'am_michael:0.6+bm_george:0.4' → the weighted mean of the two styles."""
+    if '+' not in spec and ':' not in spec:
+        return spec
+    parts = [p.split(':') for p in spec.split('+')]
+    w = np.array([float(p[1]) if len(p) > 1 else 1.0 for p in parts])
+    return sum(wi * k.get_voice_style(p[0]) for wi, p in zip(w / w.sum(), parts)).astype(np.float32)
+
+
+def bounds_of(say):
+    """→ (words, [{j: index of the word before the pause, ms}]) for the punctuation inside the line."""
+    toks = MARK.sub(lambda m: f' ⟦{m.group(1) or 0}⟧ ' if m.group(1) else ' ', say).split()
+    words, bounds = [], []
+    for tk in toks:
+        if tk.startswith('⟦'):
+            if bounds and bounds[-1]['j'] == len(words) - 1:
+                bounds[-1]['ms'] += int(tk[1:-1])
+            continue
+        words.append(tk)
+        core = tk.rstrip('"”’)')
+        if core and core[-1] in D_PAUSE:
+            bounds.append({'j': len(words) - 1, 'ms': D_PAUSE[core[-1]]})
+    return words, [b for b in bounds if b['j'] < len(words) - 1]
+
+
+def silences(x, sr, min_len=0.045, rel_db=-30):
+    """Inner runs where the 20 ms level is rel_db under the line's loud (95th percentile) level → [(t0, t1)]."""
+    n = int(sr * 0.02)
+    e = 20 * np.log10(np.sqrt(np.convolve(x.astype(np.float64) ** 2, np.ones(n) / n, 'same')) + 1e-9)
+    q = np.concatenate([[False], e < np.percentile(e, 95) + rel_db, [False]])
+    on, off = np.nonzero(q[1:] & ~q[:-1])[0], np.nonzero(~q[1:] & q[:-1])[0]
+    return [(i / sr, j / sr) for i, j in zip(on, off) if i > 0 and j < len(x) and (j - i) / sr >= min_len]
+
+
+def one_pass(words, bounds, voice, speed, g2p, f, seed=None):
+    """The whole line through the model once → [[audio, words, pause after (ms)]], cut only inside the model's own silences."""
+    text = spoken(words)
+    if seed is not None:
+        x, sr = cb_say(text, seed)
+        f = 1.0
+    else:
+        x, sr = k.create(phonemes(text, g2p), voice=voice, speed=speed / f, is_phonemes=True)
+    if abs(f - 1) > 1e-3:
+        down = int(round(1000 * f))
+        g = np.gcd(1000, down)
+        x = sps.resample_poly(x, 1000 // g, down // g).astype(np.float32)
+    x = trim(x, sr, 0.02, 0.08)
+    sil, D, used, cuts = silences(x, sr), len(x) / sr, set(), []
+    for b in bounds:
+        frac = len(' '.join(words[:b['j'] + 1])) / len(' '.join(words))
+        near = [(abs((s0 + s1) / 2 / D - frac), i) for i, (s0, s1) in enumerate(sil) if i not in used]
+        near = [c for c in near if c[0] < 0.16]
+        if near:
+            i = min(near)[1]
+            used.add(i)
+            cuts.append((sil[i], b))
+    if len(cuts) < len(bounds) and seed is None:
+        # the model ran over a punctuation mark with no silence: the punctuation groups one by one (as before --directed)
+        segs, w0 = [], 0
+        for b in bounds + [{'j': len(words) - 1, 'ms': 0}]:
+            g, _ = one_pass(words[w0:b['j'] + 1], [], voice, speed, g2p, f)
+            segs.append([g[0][0], words[w0:b['j'] + 1], b['ms']])
+            w0 = b['j'] + 1
+        return segs, sr
+    cuts.sort(key=lambda c: c[0][0])
+    segs, t, w0, n = [], 0.0, 0, int(0.008 * sr)
+    for (s0, s1), b in cuts + [((D, D), None)]:
+        piece = x[int(t * sr): int((s0 + 0.03) * sr) if b else len(x)].copy()
+        piece[:n] *= np.linspace(0, 1, n)
+        piece[-n:] *= np.linspace(1, 0, n)
+        segs.append([piece, words[w0:b['j'] + 1] if b else words[w0:], max(b['ms'], int(1000 * (s1 - s0)) - 50) if b else 0])
+        if b:
+            t, w0 = s1 - 0.02, b['j'] + 1
+    return segs, sr
+
+
+def atempo(x, sr, factor):
+    ff = shutil.which('ffmpeg')
+    if not ff:
+        import imageio_ffmpeg
+        ff = imageio_ffmpeg.get_ffmpeg_exe()
+    p = subprocess.run([ff, '-v', 'error', '-f', 'f32le', '-ar', str(sr), '-ac', '1', '-i', '-', '-af', f'atempo={factor:.5f}',
+                        '-f', 'f32le', '-ar', str(sr), '-ac', '1', '-'], input=x.astype('<f4').tobytes(), capture_output=True, check=True)
+    return np.frombuffer(p.stdout, '<f4').copy()
+
+
+def fit_line(segs, sr, old, n_old):
+    """Place each group where the same words started in the old file; → (audio of exactly n_old samples unless it does not
+    fit, new chunk times, seconds over, largest tempo change)."""
+    groups, i = [], 0
+    for _, w, _ in segs:
+        n, i0 = 0, i
+        while i < len(old) and n < len(w):
+            n += old[i]['words']
+            i += 1
+        if n != len(w):
+            groups = None
+            break
+        groups.append((old[i0]['t0'], old[i - 1]['t1']))
+    if groups is None:   # the pauses fell elsewhere than before: the line as one block
+        segs = [[np.concatenate([np.concatenate([s[0], np.zeros(int(sr * s[2] / 1000), np.float32)]) for s in segs]), sum((s[1] for s in segs), []), 0]]
+        groups = [(old[0]['t0'], old[-1]['t1'])]
+    limit = n_old / sr
+    y, t, meta, dev = np.zeros(int((limit + 4) * sr), np.float32), 0.0, [], 0.0
+    for j, ((aud, w, _), (g0, g1)) in enumerate(zip(segs, groups)):
+        nz = np.nonzero(np.abs(aud) > 0.004)[0]   # a group's silent tail is not speech
+        if len(nz):
+            aud = aud[:min(len(aud), nz[-1] + int(0.03 * sr))].copy()
+            aud[-int(0.01 * sr):] *= np.linspace(1, 0, int(0.01 * sr))
+        start, dur = max(g0, t), len(aud) / sr
+        avail = (groups[j + 1][0] - FIT_GAP if j + 1 < len(groups) else limit) - start
+        fct = min(FIT_MAX, 1.012 * dur / avail) if dur > avail else max(1 / FIT_MAX, dur / (g1 - g0)) if dur < (g1 - g0) / FIT_MAX and j + 1 < len(groups) else 1.0
+        if abs(fct - 1) > 0.004:
+            aud = atempo(aud, sr, fct)
+            dur, dev = len(aud) / sr, max(dev, abs(fct - 1))
+        y[int(start * sr): int(start * sr) + len(aud)] += aud
+        meta.append({'t0': round(start, 4), 't1': round(start + dur, 4), 'words': len(w), 'text': ' '.join(w), 'tempo': round(fct, 3)})
+        t = start + dur + FIT_GAP
+    over = max(0.0, t - FIT_GAP - limit)
+    return (y[:n_old] if over <= 0 else y[:int((t - FIT_GAP + 0.02) * sr)]), meta, over, dev
+
+
+def directed(line, c, base, f, g2p):
+    words, bounds = bounds_of(line.get('say', line['text']))
+    m = pace(line)
+    voice, sp = style_of(c['voice']), base * m
+    chatter = a.engine == 'chatterbox' and line.get('speaker', 'narrator') == 'narrator'
+    if chatter:   # no speed control: several takes, keep the one nearest the length wanted
+        takes = [one_pass(words, bounds, voice, sp, g2p, f, seed=s) for s in range(a.takes)]
+        durs = [sum(len(s[0]) for s in t[0]) / t[1] for t in takes]
+        want = sum(ch['t1'] - ch['t0'] for ch in json.load(open(f"{old_dir}/{line['id']}.json"))['chunks']) if a.fit else float(np.median(durs))
+        segs, sr = takes[int(np.argmin([abs(d - want) for d in durs]))]
+    else:
+        segs, sr = one_pass(words, bounds, voice, sp, g2p, f)
+    if not a.fit:
+        pieces, meta, t = [], [], 0.0
+        for aud, w, p in segs:
+            d = len(aud) / sr
+            meta.append({'t0': round(t, 4), 't1': round(t + d, 4), 'words': len(w), 'speed': round(sp, 3), 'text': ' '.join(w)})
+            pieces += [aud, np.zeros(int(sr * p / 1000), np.float32)]
+            t += d + p / 1000
+        print(f"   · {sp:.2f}×  one pass, {len(segs)} group(s), pace {m:.2f}")
+        return np.concatenate(pieces), sr, meta, sp, None
+    old = json.load(open(f"{old_dir}/{line['id']}.json"))
+    n_old = sf.info(f"{old_dir}/{line['id']}.wav").frames
+    target = 0.97 * sum(ch['t1'] - ch['t0'] for ch in old['chunks'])
+    cur = sum(len(s[0]) for s in segs) / sr
+    sp2 = float(np.clip(sp * cur / target, sp / FIT_MAX, sp * FIT_MAX))   # never more than ±8 % from the directed speed
+    if not chatter and abs(sp2 / sp - 1) > 0.015:
+        sp = sp2
+        segs, sr = one_pass(words, bounds, voice, sp, g2p, f)
+    audio, meta, over, dev = fit_line(segs, sr, old['chunks'], n_old)
+    top = base * m * FIT_MAX
+    while over > 0 and not chatter and sp < top - 1e-6:   # a group overran its slot: a little quicker, up to +8 %
+        sp = min(top, sp * 1.04)
+        segs, sr = one_pass(words, bounds, voice, sp, g2p, f)
+        audio, meta, over, dev = fit_line(segs, sr, old['chunks'], n_old)
+    print(f"   · {sp:.2f}×  one pass, {len(segs)} group(s), fitted: tempo ±{100 * dev:.1f} %" + (f"  DOES NOT FIT: {over:.2f} s over" if over > 0 else ''))
+    return audio, sr, old['chunks'], sp, {'chunks': meta, 'over_s': round(over, 3), 'speed': round(sp, 3)}
+
