+def cb_say(text, seed):
+    global _cb
+    if _cb is None:
+        import sys
+        sys.path.insert(0, a.cb or f'{root}/lab/voicelab')
+        import cb as cbmod
+        _cb = cbmod.CB()
+        _cb.set_ref(os.path.join(cbmod.M, 'default_voice.wav'))
+    for name, sp in RESPELL.items():
