+# Chatterbox reads spelling: how each name is written for it (the caption keeps the real spelling)
+RESPELL = {"Ruru": "Rooroo", "Ruru's": "Rooroo's", "Bhrigu": "Brigoo", "Bhrigu's": "Brigoo's", "Pramadvara": "Pramudvarah"}
+_cb = None
