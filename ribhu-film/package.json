{
  "name": "ribhu-labs-film",
  "private": true,
  "type": "module",
  "description": "One Cup, Made Four — a 30-second Ribhu Labs brand film where every frame and sound is generated from code.",
  "scripts": {
    "vendor": "esbuild vendor/three-entry.js --bundle --format=iife --minify --legal-comments=external --outfile=vendor/three.bundle.js",
    "render": "node tools/render.mjs",
    "preview": "node tools/preview.mjs",
    "audio": "python3 tools/synth.py"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "1.56.1",
    "three": "0.186.0"
  }
}
